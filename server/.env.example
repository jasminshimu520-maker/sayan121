# Server Configuration
PORT=5000
JWT_SECRET=smart_task_reminder_super_secure_jwt_key_2026

# Gmail SMTP Configuration (For Automated 3-Day Reminders & Test Emails)
# 1. Enter your Gmail address (e.g. yourname@gmail.com)
# 2. Generate a 16-character Google App Password:
#    Go to: Google Account -> Security -> 2-Step Verification -> App Passwords
#    Create an app password for 'Mail', then paste the 16 characters below (no spaces).
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password_here

# Scheduler Configuration (Standard 5-part cron: '5 0 * * *' = daily at 00:05 AM)
CRON_SCHEDULE=5 0 * * *
